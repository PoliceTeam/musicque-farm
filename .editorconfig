root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Pixel grids: whitespace is never meaningful, but keep lines exactly as drawn.
[apps/game/src/assets/sprites/**/*.txt]
trim_trailing_whitespace = false
