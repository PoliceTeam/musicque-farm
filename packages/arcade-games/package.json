{
  "name": "@chibi-town/arcade-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --formatter-enabled=false"
  },
  "dependencies": {
    "@chibi-town/game-content": "workspace:*",
    "chess.js": "^1.4.0",
    "@chibi-town/character-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
