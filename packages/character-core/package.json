    },
    "./item-loader": {
      "types": "./dist/item-loader.d.ts",
      "default": "./dist/item-loader.js"
    },
    "./random": {
      "types": "./dist/random.d.ts",
      "default": "./dist/random.js"
    },
    "./item-catalog": {
      "types": "./dist/item-catalog.d.ts",
