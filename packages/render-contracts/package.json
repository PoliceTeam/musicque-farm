{
  "name": "@chibi-town/render-contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./renderer-types": {
      "types": "./dist/renderer-types.d.ts",
      "default": "./dist/renderer-types.js"
    },
    "./renderer-registry": {
      "types": "./dist/renderer-registry.d.ts",
      "default": "./dist/renderer-registry.js"
    },
