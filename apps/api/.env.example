# Copy to .env. `pnpm --filter @chibi-town/api db:up` starts this database with Docker.
DATABASE_URL=postgres://chibi:chibi@127.0.0.1:5433/chibi_town
# Without Docker: an in-process database stored in a folder (development only).
# DATABASE_URL=pglite:.data/dev
HOST=127.0.0.1
PORT=3001
# Origin of the game app; the only origin allowed to call the API with cookies.
WEB_ORIGIN=http://127.0.0.1:5173
# Public base URL of this API, used for the Google redirect URI.
PUBLIC_API_URL=http://127.0.0.1:3001/api
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# All API and worker processes must share this Redis and the same PostgreSQL database.
# Empty uses process-local memory. Do not share a PGlite folder between processes.
# Install dependencies with pnpm install; the node-redis client is pinned to 5.8.2.
# Dev Redis: docker run --rm -p 6379:6379 redis:7-alpine
# Use rediss:// and credentials for a remote Redis. No memory fallback on Redis errors.
REDIS_URL=redis://127.0.0.1:6379
# Set true when REDIS_URL is a Redis Cluster seed node.
REDIS_CLUSTER=false

# Reset pet race odds once per scheduled day. All API instances must use the same values.
# Disabling also disables startup/new-round catch-up; payout settlement keeps running.
PET_RACE_RESET_ENABLED=true
PET_RACE_RESET_TIME=00:00
PET_RACE_RESET_TIMEZONE=Asia/Ho_Chi_Minh

# Worker mode requires PostgreSQL + Redis. Start `pnpm --filter @chibi-town/api worker` separately.
# Use embedded for a single-process PGlite setup (no separate worker).
BACKGROUND_JOBS_MODE=worker
WORKER_CONCURRENCY=2
