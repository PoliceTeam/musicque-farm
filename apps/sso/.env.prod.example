# Override lệnh qua shell: SERVER, SSH_KEY, REMOTE_DIR, ENV_FILE, PROJECT_NAME, TUNNEL_PORT, SSO_PORT.
# REQUIRED = bắt buộc cho production police có SSO; biến không có nhãn là tùy chọn.
# Secret để trống: sinh riêng bằng openssl rand -hex 32; client secret phải khớp Keycloak.
# Token key mỗi backend khác nhau; không đổi key/mật khẩu DB đang dùng khi deploy thường kỳ.
# Copy via `node apps/sso/init.mjs`; never reuse development secrets in production.
# REQUIRED: SSO_URL
SSO_URL=https://musicque.politetech.com/sso
# Admin API via tunnel; override per invocation (not the public issuer).
# REQUIRED: SSO_ADMIN_URL
SSO_ADMIN_URL=http://127.0.0.1:18180/sso
# REQUIRED: SSO_NETWORK
SSO_NETWORK=musicque_music-order-network
SSO_PORT=8180
# REQUIRED: SSO_ADMIN_USERNAME
SSO_ADMIN_USERNAME=sso-admin
# REQUIRED: SSO_ADMIN_PASSWORD
SSO_ADMIN_PASSWORD=
# REQUIRED: SSO_DATABASE_PASSWORD
SSO_DATABASE_PASSWORD=
# REQUIRED: SSO_FARM_CLIENT_SECRET
SSO_FARM_CLIENT_SECRET=
# REQUIRED: SSO_MUSICQUE_CLIENT_SECRET
SSO_MUSICQUE_CLIENT_SECRET=
# REQUIRED: SSO_FARM_REDIRECT_URI
SSO_FARM_REDIRECT_URI=https://musicque.politetech.com/farm/api/auth/sso/callback
# REQUIRED: SSO_MUSICQUE_REDIRECT_URI
SSO_MUSICQUE_REDIRECT_URI=https://musicque.politetech.com/api/auth/sso/callback
# Web origins allowed as post-logout redirects.
# REQUIRED: SSO_FARM_WEB_ORIGIN
SSO_FARM_WEB_ORIGIN=https://musicque.politetech.com
# REQUIRED: SSO_FARM_WEB_URL
SSO_FARM_WEB_URL=https://musicque.politetech.com/farm
# REQUIRED: SSO_MUSICQUE_WEB_ORIGIN
SSO_MUSICQUE_WEB_ORIGIN=https://musicque.politetech.com
# Optional Google sign-in brokered by Keycloak (redirect URI: <SSO_URL>/realms/sso/broker/google/endpoint).
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Optional SMTP for forgot-password and email verification.
SSO_SMTP_HOST=
SSO_SMTP_PORT=587
# true = SSL trực tiếp (vd Gmail cổng 465); để trống = STARTTLS (587).
SSO_SMTP_SECURE=
SSO_SMTP_USER=
SSO_SMTP_PASSWORD=
SSO_SMTP_FROM=

# Handoff endpoints used by configure.mjs; keys generated per backend, never shared cookies.
# REQUIRED: SSO_FARM_HANDOFF_ACCEPT
SSO_FARM_HANDOFF_ACCEPT=https://musicque.politetech.com/farm/api/auth/handoff/accept
# REQUIRED: SSO_MUSICQUE_HANDOFF_ACCEPT
SSO_MUSICQUE_HANDOFF_ACCEPT=https://musicque.politetech.com/api/auth/handoff/accept

# Backend token-encryption keys; each platform keeps its own key.
# REQUIRED: SSO_FARM_TOKEN_KEY
SSO_FARM_TOKEN_KEY=
# REQUIRED: SSO_MUSICQUE_TOKEN_KEY
SSO_MUSICQUE_TOKEN_KEY=

# URL được Keycloak quảng bá cho admin console qua tunnel.
SSO_ADMIN_HOSTNAME=http://localhost:18180/sso
