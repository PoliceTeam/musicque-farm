{
  "name": "@chibi-town/game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../tools/runtime/run-game-task.mjs dev",
    "build": "node ../../tools/runtime/run-game-task.mjs build",
    "preview": "next start --hostname 127.0.0.1 --port 5173",
    "typecheck": "node ../../tools/runtime/run-game-task.mjs typecheck",
    "test": "node ../../tools/runtime/run-game-task.mjs test",
    "check": "pnpm typecheck && pnpm test",
    "lint": "biome check . --formatter-enabled=false",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "prepare-assets": "node ../../tools/runtime/prepare-assets.mjs",
    "analyze": "ANALYZE=true NEXT_ANALYSIS_DIR=.next-perf NEXT_PUBLIC_BASE_PATH=/farm NEXT_PUBLIC_API_URL=/farm/api node ../../tools/runtime/run-game-task.mjs build"
  },
  "devDependencies": {
    "@chibi-town/arcade-games": "workspace:*",
    "@chibi-town/game-service": "workspace:*",
    "@next/bundle-analyzer": "^16.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "phaser": "^4.2.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@chibi-town/api-sdk": "workspace:*",
    "@chibi-town/arcade-games-react": "workspace:*",
    "@chibi-town/character-core": "workspace:*",
    "@chibi-town/contracts": "workspace:*",
    "@chibi-town/game-audio": "workspace:*",
    "@chibi-town/game-content": "workspace:*",
    "@chibi-town/gameplay": "workspace:*",
    "@chibi-town/render-contracts": "workspace:*",
    "@chibi-town/renderer-canvas": "workspace:*",
    "@chibi-town/renderer-phaser": "workspace:*",
    "@chibi-town/ui": "workspace:*",
    "i18next": "^26.4.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  }
}
