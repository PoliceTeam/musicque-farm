# Leave unset for the local IndexedDB adapter.
# Backend must implement docs/api-sdk.md before enabling HTTP.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api

# Local adapter only, ignored by production and HTTP SDK.
# 600x: 1 game hour = 6 real seconds; set 1 for normal speed.
NEXT_PUBLIC_DEV_TIME_SCALE=600
NEXT_PUBLIC_DEV_COINS=5000000
NEXT_PUBLIC_DEV_GEMS=1000
# Dev uses a separate save, cloned once from your current local progress.

# Public origin (and base path) of the game, used for absolute share-image URLs, e.g. https://musicque.politetech.com/farm
# NEXT_PUBLIC_SITE_URL=
