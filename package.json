{
  "name": "musicque-farm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=16",
    "build": "turbo run build",
    "preview": "pnpm --filter @chibi-town/game preview",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format:check": "biome format . && node tools/format/function-spacing.mjs --check",
    "format": "biome format --write . && node tools/format/function-spacing.mjs --write && biome format --write .",
    "check": "pnpm format:check && pnpm format:test && turbo run lint typecheck test && pnpm tooling:test",
    "format:test": "node --test tools/format/function-spacing.test.mjs",
    "tooling:test": "node --test tools/tooling/*.test.mjs",
    "sso:up": "pnpm --filter @chibi-town/sso sso:up",
    "sso:configure": "pnpm --filter @chibi-town/sso sso:configure",
    "sso:sync": "pnpm --filter @chibi-town/sso sso:sync",
    "sso:sync:prod": "bash apps/sso/deploy.prod.sh --sync-only",
    "sso:down": "pnpm --filter @chibi-town/sso sso:down",
    "deploy:prod": "bash scripts/deploy.prod.sh",
    "deploy:web": "bash scripts/deploy.prod.sh --web-only",
    "deploy:api": "bash scripts/deploy.prod.sh --api-only",
    "deploy:build": "bash scripts/deploy.prod.sh --build-only",
    "deploy:rollback": "bash scripts/rollback.prod.sh",
    "deploy:status": "bash scripts/remote.prod.sh status",
    "deploy:logs": "bash scripts/remote.prod.sh logs",
    "sso:deploy": "bash apps/sso/deploy.prod.sh",
    "sso:admin": "bash scripts/remote.prod.sh sso-admin",
    "env:check": "node scripts/env-check.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.9.0"
  }
}
