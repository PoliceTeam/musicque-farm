{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["biome.json", "pnpm-workspace.yaml"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "@chibi-town/character-core#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@chibi-town/renderer-phaser#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@chibi-town/game#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "prepare-assets"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/runtime/run-game-task.mjs"]
    },
    "@chibi-town/game#build": {
      "dependsOn": ["^build", "prepare-assets"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/runtime/run-game-task.mjs"],
      "env": ["NEXT_PUBLIC_*", "NEXT_OUTPUT", "ANALYZE", "NEXT_ANALYSIS_DIR"]
    },
    "@chibi-town/game#typecheck": {
      "dependsOn": ["^build", "prepare-assets"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/runtime/run-game-task.mjs"]
    },
    "@chibi-town/game#test": {
      "dependsOn": ["^build", "prepare-assets"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/runtime/run-game-task.mjs",
        "$TURBO_ROOT$/tools/runtime/map-assets.test.mjs"
      ]
    },
    "@chibi-town/game#prepare-assets": {
      "inputs": [
        "package.json",
        "src/assets/**",
        "!src/assets/generated-*.ts",
        "!src/assets/generated-styles/**",
        "src/**/*.css",
        "$TURBO_ROOT$/packages/ui/src/theme.css",
        "$TURBO_ROOT$/packages/arcade-games-react/src/theme.css",
        "$TURBO_ROOT$/tools/runtime/prepare-assets.mjs",
        "$TURBO_ROOT$/tools/runtime/build-map-assets.mjs",
        "$TURBO_ROOT$/tools/farm-runtime-assets.json",
        "$TURBO_ROOT$/tools/entertainment/assets.json",
        "$TURBO_ROOT$/tools/scenery/assets.json",
        "$TURBO_ROOT$/tools/shopping/assets.json",
        "$TURBO_ROOT$/tools/salon/assets.json",
        "$TURBO_ROOT$/tools/pet-shop/assets.json",
        "$TURBO_ROOT$/tools/held-shop/assets.json",
        "$TURBO_ROOT$/tools/premium-shop/assets.json",
        "$TURBO_ROOT$/tools/jewelry-shop/assets.json",
        "$TURBO_ROOT$/tools/fashion-shop/assets.json",
        "$TURBO_ROOT$/tools/shop-npcs/assets.json",
        "$TURBO_ROOT$/tools/arcade/assets.json"
      ],
      "outputs": [
        "src/assets/generated-assets.ts",
        "src/assets/generated-map-assets.ts",
        "src/assets/generated-sprite-sources.ts",
        "src/assets/generated-styles.ts",
        "src/assets/generated-styles/**",
        "public/chibi-assets/**"
      ]
    },
    "@chibi-town/api#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["REDIS_URL"],
      "cache": false
    },
    "@chibi-town/realtime-redis#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["REDIS_URL"],
      "cache": false
    },
    "@chibi-town/jobs#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["REDIS_URL"],
      "cache": false
    }
  }
}
