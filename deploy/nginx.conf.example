# /etc/nginx/sites-available/chibi-town  (then: ln -s ../sites-available/chibi-town /etc/nginx/sites-enabled/)
# Issue the certificate with: certbot --nginx -d game.example.com
map $http_upgrade $chibi_connection {
  default upgrade;
  ''      close;
}
server {
  listen 80;
  server_name game.example.com;

  client_max_body_size 1m;

  location /api/ {
    proxy_pass http://127.0.0.1:3201;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # WebSocket at /api/ws
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $chibi_connection;
    proxy_read_timeout 1h;
  }

  location / {
    proxy_pass http://127.0.0.1:3200;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
