# Copy to deploy/.env.prod (never commit it). Used by scripts/deploy.prod.sh and docker compose on the server.
# Public address of the game, without a trailing slash. Must be HTTPS: session cookies are Secure in production.
PUBLIC_URL=https://musicque.politetech.com/farm
PUBLIC_API_URL=https://musicque.politetech.com/farm/api
NEXT_PUBLIC_BASE_PATH=/farm
NEXT_PUBLIC_API_URL=/farm/api
NEXT_PUBLIC_SITE_URL=https://musicque.politetech.com
# Existing Musicque Docker network; create/override for another host.
SSO_NETWORK=musicque_music-order-network
# Host ports nginx proxies to; only bound to 127.0.0.1. do not publish PostgreSQL or Redis.
WEB_PORT=3200
API_PORT=3201
DATABASE_NAME=chibi_town
DATABASE_USERNAME=chibi
# Generate with: openssl rand -hex 24
DATABASE_PASSWORD=
# Optional Google sign-in; redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pet race daily reset; keep the same schedule on every API instance.
PET_RACE_RESET_ENABLED=true
PET_RACE_RESET_TIME=00:00
PET_RACE_RESET_TIMEZONE=Asia/Ho_Chi_Minh

# Shared queue and realtime bus. Redis is included in the stack.
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=2

# Optional self-hosted SSO; enable all three together after configuring the realm.
SSO_ADMIN_URL=http://sso:8080/sso
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Backend only: 32 random bytes encoded as 64 hex characters.
SSO_TOKEN_KEY=
# Comma separated clientId=absolute accept URL; HTTPS outside loopback dev.
SSO_HANDOFF_TARGETS=musicque=https://musicque.politetech.com/api/auth/handoff/accept
SSO_HANDOFF_ORIGINS=https://musicque.politetech.com
